# ===== Railway 部署环境变量 =====
# 在 Railway Dashboard → Variables 中配置以下变量

# Supabase 配置
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key

# 环境模式: DEV=开发, PROD=生产
COZE_PROJECT_ENV=PROD

# 服务端口（Railway 自动分配，无需手动设置）
# PORT=3000

# 后端 API 地址（容器内通信，默认 localhost:8001 即可）
# NEXT_PUBLIC_API_URL=http://localhost:8001
